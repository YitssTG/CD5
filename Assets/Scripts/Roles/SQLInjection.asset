  m_Script: {fileID: 11500000, guid: 620245a895bd4dda887f9555aa75fb69, type: 3}
  m_Name: SQLInjection
  m_EditorClassIdentifier: Assembly-CSharp::IncidentDefinition
  incidentId: SQLI-001
  title: Acceso anomalo al portal de matriculas
  wrongReportPenalty: 10
  wrongReportDelay: 0
  interactionRadius: 4
  evidence: "[09:41:02] Portal de matriculas: solicitud de inicio de sesion.\n[09:41:02] Campo usuario contiene comillas y una condicion logica inesperada.\n[09:41:02] Traza: entrada del formulario concatenada en una consulta SQL.\n[09:41:03] La consulta devuelve varias cuentas; el usuario no tenia una sesion valida.\n[09:41:04] No hay una secuencia masiva de intentos ni correos sospechosos.\n\nEvidencia simulada: identifica que frontera entre datos e instrucciones se ha perdido."
  explanation: "La aplicacion concatenaba datos del usuario con instrucciones SQL. Esto permitia alterar la consulta. Las consultas parametrizadas separan instrucciones y valores: la entrada se trata como datos. Reiniciar o cambiar una clave no elimina esta causa. La contencion limita el impacto, pero no sustituye la reparacion. La verificacion simulo una entrada sospechosa rechazada y un acceso legitimo correcto. El Pentester aporto evidencias y verifico; el Administrador contuvo y reparo. Todo el ejercicio es simulado."
  serverId: SRV-01
  analysisSeconds: 5
  containmentSeconds: 3
  repairSeconds: 5
  verificationSeconds: 4
  tabletWalkMultiplier: 0.65
  scoring:
    hintCost: 3
    accuracyBonus: 5
    cooperationBonus: 10
    maxPenalty: 0
  steps:
  - stepId: "scan"
    objectiveType: 0
    stage: 1
    authorizedRole: 2
    successPoints: 5
    penaltyPoints: 10
    penaltyDelay: 0
    objective: "Identifica SRV-01 e inicia el analisis"
    briefing: "El portal registra accesos sin sesion valida. Analiza el servidor para obtener evidencias."
    successFeedback: "Completado: Identifica SRV-01 e inicia el analisis"
    failureFeedback: "La decision no corresponde a las evidencias o al orden requerido. Revisa la explicacion y reintenta."
    completesIncident: 0
    hints: []
    minigame:
      kind: 0
      prompt: ""
      correctFeedback: ""
      wrongFeedback: ""
      requiredOrder:
      options: []
  - stepId: "evidence"
    objectiveType: 0
    stage: 2
    authorizedRole: 2
    successPoints: 10
    penaltyPoints: 10
    penaltyDelay: 0
    objective: "Selecciona las evidencias relevantes en el servidor"
    briefing: "[09:41:02] Portal de matriculas: solicitud de inicio de sesion.\n[09:41:02] Campo usuario contiene comillas y una condicion logica inesperada.\n[09:41:02] Traza de la aplicacion: entrada del formulario concatenada en una consulta SQL.\n[09:41:03] La consulta devuelve varias cuentas; el usuario no tenia una sesion valida.\n[09:41:04] No hay una secuencia masiva de intentos ni correos sospechosos.\n\nEvidencia simulada: identifica que frontera entre datos e instrucciones se ha perdido."
    successFeedback: "Completado: Selecciona las evidencias relevantes en el servidor"
    failureFeedback: "La decision no corresponde a las evidencias o al orden requerido. Revisa la explicacion y reintenta."
    completesIncident: 0
    hints:
    - "Distingue lo observado de las explicaciones sin evidencia."
    - "Busca la frontera perdida entre datos e instrucciones."
    minigame:
      kind: 2
      prompt: "Marca todas las evidencias relevantes"
      correctFeedback: ""
      wrongFeedback: ""
      requiredOrder:
      options:
      - id: "concat"
        label: "Entrada concatenada en SQL"
        detail: ""
